{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", "firestore.rules", "**/.*", "**/node_modules/**",
      "functions/**", "tests/**", "server.js", "package.json", "README.md"
    ],
    "rewrites": [
      { "source": "/api/fetch", "function": { "functionId": "fetchRecipe", "region": "us-central1" } }
    ]
  },
  "functions": [
    { "source": "functions", "codebase": "default", "runtime": "nodejs22" }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
